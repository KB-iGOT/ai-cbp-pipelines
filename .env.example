# Copy to .env and fill in:  cp .env.example .env
# Only these settings are read; every one and its default is in src/common/settings.py.
# Environment variables override this file.

LOG_LEVEL=INFO

# ── Required ──────────────────────────────────────────────────────────────────
# Postgres: the same database as cbp-ai-service. postgresql:// and postgresql+asyncpg:// both work.
DATABASE_URL=postgresql://localhost:5432/cbp_local

# KB composite search API (required by both pipelines)
KB_BASE_URL=https://<kb-host>
KB_AUTH_TOKEN="Bearer <token>"

# Gemini API key (course_ingestion only; course_retirement doesn't need it)
GOOGLE_API_KEY=

# ── Kafka ─────────────────────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_SECURITY_PROTOCOL=PLAINTEXT          # PLAINTEXT | SSL | SASL_PLAINTEXT | SASL_SSL
KAFKA_COURSE_INGESTION_TOPIC=local.course.ingestion
KAFKA_COURSE_RETIREMENT_TOPIC=local.course.retirement

# Only for a secured cluster:
# KAFKA_SASL_MECHANISM=SCRAM-SHA-512       # PLAIN | SCRAM-SHA-256 | SCRAM-SHA-512
# KAFKA_SASL_USERNAME=
# KAFKA_SASL_PASSWORD=
# KAFKA_SSL_CAFILE=/path/to/ca.pem

# ── Optional tuning (defaults shown) ─────────────────────────────────────────
# GOOGLE_EMBEDDING_MODEL=gemini-embedding-2
# EMBEDDING_OUTPUT_DIMENSIONALITY=1536     # must match the vector columns in the table
# EMBEDDING_CONCURRENCY=20
# DB_POOL_MIN_SIZE=1
# DB_POOL_MAX_SIZE=10
# KAFKA_MAX_POLL_RECORDS=50                # use 10 for course_retirement
# PIPELINE_CONCURRENCY=10
# PIPELINE_MAX_ATTEMPTS=4
# PIPELINE_RETRY_BACKOFF_SECONDS=5
